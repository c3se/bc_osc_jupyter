---
cluster: "alvis"
form:
  - cluster
  - bc_account
  - bc_num_hours
  - node_type
  - version
  - working_dir
  - bc_email_on_started
attributes:
  bc_account:
    label: "Project"
    help: "Write in your project"
  node_type:
    widget: "select"
    label: "Node type"
    options:
      - [ "1xT4", "1xT4", data-option-for-alvis: true ]
      - [ "2xT4", "2xT4", data-option-for-alvis: true ]
      - [ "3xT4", "3xT4", data-option-for-alvis: true ]
      - [ "4xT4", "4xT4", data-option-for-alvis: true ]
      - [ "5xT4", "5xT4", data-option-for-alvis: true ]
      - [ "6xT4", "6xT4", data-option-for-alvis: true ]
      - [ "7xT4", "7xT4", data-option-for-alvis: true ]
      - [ "8xT4", "8xT4", data-option-for-alvis: true ]
      - [ "1xV100", "1xV100", data-option-for-alvis: true ]
      - [ "2xV100", "2xV100", data-option-for-alvis: true ]
      - [ "3xV100", "3xV100", data-option-for-alvis: true ]
      - [ "4xV100", "4xV100", data-option-for-alvis: true ]
  version:
    widget: "select"
    label: "Runtime"
    options:
      - [ "Python 3.8.6, TensorFlow 2.5.0, PyTorch 1.7.1",  "/apps/jupyter/python-3.8.6-tensorflow-2.5.0-pytorch-1.7.1.sh" ]
      - [ "Container: TensorFlow 2.2.0 NGC",  "/apps/jupyter/TensorFlow-2.2.0-NGC.sh" ]
      - [ "User specified (create ~/jupyter1.sh)",  "~/jupyter1.sh" ]
      - [ "User specified (create ~/jupyter2.sh)",  "~/jupyter2.sh" ]
      - [ "User specified (create ~/jupyter3.sh)",  "~/jupyter3.sh" ]
    help: "See /apps/jupyter/ for examples on how to create your own custom environment"
  working_dir:
    label: "Working Directory"
    data-filepicker: true
    data-target-file-type: dirs  # Valid values are: files, dirs, or both
    readonly: false
    help: "Select your project directory; defaults to $HOME"
